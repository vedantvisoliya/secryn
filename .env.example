# Secryn API.
# LOCAL DEV: leave unset. The app calls same-origin /api/... and Vite proxies
# it to the backend, because the backend's CORS allowlist rejects localhost.
# VERCEL: set this to https://api-key-lister.fastapicloud.dev
# VITE_API_BASE_URL=

# Firebase web config — Project settings -> General -> Your apps -> SDK setup.
# These are public identifiers, not secrets, but must be set per environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional. The Google OAuth client id the backend validates against
# (its GOOGLE_CLIENT_ID). When set, an audience mismatch is caught in the
# browser with a clear message instead of an opaque 401 from /auth/login.
VITE_GOOGLE_CLIENT_ID=
